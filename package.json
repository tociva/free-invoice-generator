{
  "name": "free-invoice-generator-2.0",
  "version": "0.0.3",
  "engines": {
    "node": ">=22.22.3 <23",
    "pnpm": "10.34.5"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 0.0.0.0",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:e2e": "playwright test",
    "format": "prettier --write src e2e playwright.config.ts package.json angular.json tsconfig*.json pnpm-workspace.yaml"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "dependencies": {
    "@angular/common": "^22.1.5",
    "@angular/compiler": "^22.1.5",
    "@angular/core": "^22.1.5",
    "@angular/forms": "^22.1.5",
    "@angular/platform-browser": "^22.1.5",
    "@angular/router": "^22.1.5",
    "@ng-icons/bootstrap-icons": "^33.0.0",
    "@ng-icons/core": "^33.0.0",
    "@ngrx/signals": "^22.0.0",
    "@tailng-ui/cdk": "0.58.0",
    "@tailng-ui/components": "0.117.0",
    "@tailng-ui/icons": "0.21.0",
    "@tailng-ui/primitives": "0.85.0",
    "@tailng-ui/theme": "0.75.0",
    "dayjs": "^1.11.19",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.7",
    "@angular/cli": "^22.1.7",
    "@angular/compiler-cli": "^22.1.5",
    "@playwright/test": "^1.63.0",
    "@types/html2canvas": "^1.0.0",
    "@types/jspdf": "^2.0.0",
    "jsdom": "^27.1.0",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "vitest": "^4.0.8"
  }
}
